# Server Configuration
SERVER_PORT=8080

# Database Configuration
#DB_URL=jdbc:postgresql://localhost:5432/etatcivil
DB_URL=jdbc:postgresql://db:5432/etatcivil
DB_USERNAME=etatcivil_user
DB_PASSWORD=etatcivil
DB_DRIVER=org.postgresql.Driver

# JPA/Hibernate Configuration
HIBERNATE_DDL_AUTO=update
HIBERNATE_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Mail Configuration
MAIL_HOST=localhost
MAIL_PORT=1025

# AI/Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# File Upload Configuration
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=20MB

# JWT Configuration
JWT_SECRET=change-this-secret-in-a-real-env-min-32-chars-long
JWT_EXPIRATION_MS=86400000

# Application Configuration
APP_NAME=e-etatcivil
UPLOAD_DIR=uploads
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
